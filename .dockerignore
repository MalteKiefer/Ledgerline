.git
.github
.claude
.superpowers
docs
*.md
scripts/*.log
.DS_Store

# Front-end: node_modules + build output are produced inside the image.
frontend/node_modules
frontend/dist

# Back-end: vendor is reinstalled in the image; never bake dev/runtime state.
backend/vendor
backend/public/build
backend/public/hot
backend/public/storage
backend/storage/*.key
backend/storage/app/**
backend/storage/framework/cache/**
backend/storage/framework/sessions/**
backend/storage/framework/views/**
backend/storage/logs/**
backend/tests
backend/.phpunit.cache
backend/.phpunit.result.cache

# Never bake env files (leak variable names/secrets) or a dev SQLite DB.
.env
.env.*
backend/.env
backend/.env.*
backend/ledgerline
backend/database/*.sqlite
backend/database/*.sqlite-shm
backend/database/*.sqlite-wal
*.sqlite
*.sqlite-shm
*.sqlite-wal

# Operator-supplied runtime data (bind-mounted at deploy time, e.g. GraphHopper).
data/
